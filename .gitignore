# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# keep .env.example tracked
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos soltos de sessões (não versionar)
package-lock.json
RESULTADO.md
dev-server.log
# screenshots descartáveis de rodadas (mantidos localmente, não versionados)
docs/screens-jogo/r2-*
docs/screens-jogo/c2-*
docs/screens-jogo/w3-*
docs/screens-jogo/v2-*
docs/screens-jogo/_base-*
docs/screens-jogo/_diag-*
build.log
prod-server.log
